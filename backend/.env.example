# ---- LLM 配置（OpenAI 兼容协议）----
# 不填写 LLM_API_KEY 时，系统会自动降级为模板/启发式输出，端到端流程仍可演示
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://ai-allocate.techgp.cn/v1
LLM_MODEL=MiniMax-M2.7-153k
LLM_USER_AGENT=Cursor
LLM_TIMEOUT=120

# ---- dbt 仓库 ----
# 默认指向项目内置示例工程，可改为你自己的 dbt 项目根路径
DBT_PROJECT_DIR=../sample_dbt_project

# ---- 数据库 ----
SQLITE_PATH=./data_dev_copilot.db

# ---- 服务 ----
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- 安全 ----
ALLOW_EXTERNAL_LLM=true
